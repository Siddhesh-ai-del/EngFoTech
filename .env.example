# ── Required ────────────────────────────────────────────────────────────────
# Google Gemini API key — powers every AI feature (roadmaps, resume review,
# mentor chat, mock interviews).
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Optional: local backend only ─────────────────────────────────────────────
# The UI no longer uses accounts (everything is saved in your browser), so these
# are only needed if you revive the API in server.ts. Left unset, nothing breaks.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Origin of this app, used as the OAuth redirect base.
# Local: http://localhost:3000  ·  Production: https://your-domain.com
APP_URL=http://localhost:3000

# ── Optional: server tuning ─────────────────────────────────────────────────
# Port for the Express server (defaults to 3000).
# PORT=3000
# SQLite file location (defaults to ./engfotech.db). Use :memory: for tests.
# DATABASE_PATH=engfotech.db
